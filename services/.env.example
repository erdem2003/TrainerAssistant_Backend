# ---------------------------------------------------------------------------
# Ortam degiskenleri — ORNEK DOSYA
#
# Kullanim:  cp .env.example .env   ve .env icindeki degerleri doldur.
#
# .env DEPOYA GIRMEZ (.gitignore). Gercek parolalar yalnizca orada durur;
# service-contract §11: "Sir kodda yok."
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=trainer
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_PAROLA_YAZ

# --- Loglama ---
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# E-POSTA (SMTP)
# ---------------------------------------------------------------------------
# Gonderim `smtplib` (standart kutuphane) ile yapiliyor. Ek bagimlilik yok.
#
# GMAIL ICIN: normal hesap parolasi CALISMAZ. "Uygulama sifresi" (App Password)
# uretmen gerekiyor:
#
#   1. Google Hesabim > Guvenlik > 2 Adimli Dogrulama'yi AC   (zorunlu on kosul)
#   2. Google Hesabim > Guvenlik > Uygulama sifreleri
#   3. "Mail" + "Diger" secip bir ad ver (or. TrainerAsistant)
#   4. Uretilen 16 haneli sifreyi SMTP_PASSWORD alanina yapistir
#      (bosluklari silebilirsin)
#
# Bu sifre normal parolan DEGILDIR, yalnizca mail gondermeye yarar ve istedigin
# zaman iptal edebilirsin.
#
# Diger saglayicilar:
#   Outlook/Hotmail : smtp-mail.outlook.com : 587 : TLS
#   Yandex          : smtp.yandex.com       : 587 : TLS
#   Mailtrap (test) : sandbox.smtp.mailtrap.io : 2525 : TLS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=BURAYA_KENDI_EPOSTANI_YAZ@gmail.com
SMTP_PASSWORD=BURAYA_16_HANELI_UYGULAMA_SIFRESI

# Gonderen adresi. SMTP_USERNAME ile AYNI adres olmali — farkli olursa
# saglayici mesaji reddeder ya da spam'e duser.
MAIL_FROM=AI Fitness Coach <BURAYA_KENDI_EPOSTANI_YAZ@gmail.com>


# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Anahtarlar dosyadan okunuyor, ortam degiskeninden DEGIL — private key'in uzun
# bir metin olarak ortamda dolasmasi gereksiz risk.
#
# Uretmek icin:   ./infra/generate-keys.sh
# Anahtarlar infra/keys/ altina yazilir ve .gitignore'dadir.

# --- Servisler arasi (Phase 10 koprusu) ---
# auth-service'in worker'i hesap silindiginde user-service'i cagirir.
# Bu uc gateway'de YAYINLANMIYOR; anahtar ikinci savunma hatti.
# Uret: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=BURAYA_RASTGELE_BIR_ANAHTAR
