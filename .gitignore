# =============================================================================
# Videolar ve ham landmark kayitlari depoya girmez: hem buyuk hem KISISEL VERI
# (ADR 0002 goruntunun cihazdan cikmamasini soyluyor; ayni mantik depoya da
# girmemesini gerektiriyor).
*.mp4
*.mov
*.avi
data/raw/
data/videos/
*.tflite
*.onnx
*.pt
*.pth
*.h5

# Pose kayitlari — kullanicinin KENDI vucut hareketinin izi. Anonim gorunuyor
# ama bir kisinin boy oranlarini ve hareket imzasini tasiyor.
*.poserec
poserec/
poserec_*/
recordings/

# Uretilen dataset dosyalari. Kaynagi (kayitlar + uretim betigi) yeterli;
# ciktinin kendisi buyuk ve yeniden uretilebilir.
dataset/
dataset_*/
*.parquet

.claude
